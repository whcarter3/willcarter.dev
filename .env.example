# ── Giscus (comment system) ──────────────────────────────────────────
# Generate these values at https://giscus.app
#
# 1. Your GitHub repo in owner/name format (e.g. willcarter/willcarter.dev)
NEXT_PUBLIC_GISCUS_REPO=
# 2. Repository ID (from giscus.app after selecting your repo)
NEXT_PUBLIC_GISCUS_REPO_ID=
# 3. Discussion category name (e.g. "Announcements", "Blog Comments")
NEXT_PUBLIC_GISCUS_CATEGORY=
# 4. Discussion category ID (from giscus.app after selecting your category)
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# 5. Mapping strategy — "pathname" creates one discussion per page URL
NEXT_PUBLIC_GISCUS_MAPPING=pathname
